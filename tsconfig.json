{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `workers` is a Cloudflare Worker with its own tsconfig and its own globals
  // (ForwardableEmailMessage and friends come from @cloudflare/workers-types,
  // not from the DOM lib this app compiles against). Left in, `next build`
  // typechecks it against the wrong world and fails.
  "exclude": ["node_modules", "scripts", "prisma/seed.ts", "workers"]
}
