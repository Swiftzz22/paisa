// Expense tracker schema.
// All amounts are in INR (paise stored as Decimal). One currency by design (v1).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  image     String? // Google profile picture URL
  googleSub String?  @unique // Google's stable subject id (the real identity key)
  // Apple's stable subject id. Kept separate from googleSub because the same
  // person can hold both, and because Apple's private-relay addresses mean
  // email cannot be used to recognise them — a user signing in with Apple may
  // present an @privaterelay.appleid.com address that matches nothing.
  appleSub  String?  @unique
  // Apple's refresh token, AES-256-GCM encrypted like the Gmail one. Obtained
  // by exchanging the authorization code at sign-in — it has to be captured
  // then, because the code is single-use and expires in five minutes. Apple
  // requires it later: deleting an account must revoke the grant, and the
  // revoke endpoint accepts nothing else.
  appleRefreshTokenEnc String?
  appleLinkedAt        DateTime?
  // Random label in this user's private forwarding address
  // (<inboundKey>@in.<domain>). Bank alerts forwarded there are ingested as if
  // we had read them from the mailbox — which is how the app avoids holding
  // Gmail access at all. Nullable so existing rows need no backfill; one is
  // minted the first time the address is asked for.
  inboundKey String? @unique
  // UNUSED. Groundwork for a subscription that was started and then dropped in
  // favour of a tip jar, which gates nothing and needs no server at all. The
  // columns exist in both databases already, so they are declared here to keep
  // the schema matching what is actually there rather than adding to the drift
  // this project already has. Nothing reads or writes them.
  plusUntil DateTime?
  billingCustomerId String? @unique
  createdAt DateTime @default(now())

  transactions        Transaction[]
  categories          Category[]
  importBatches       ImportBatch[]
  receivedEmails      ReceivedEmail[]
  categorizationRules CategorizationRule[]
  merchantAliases     MerchantAlias[]
  emailAccounts       EmailAccount[]
  paymentModes        PaymentMode[]
  budgets             Budget[]
  sessions            Session[]
  passkeys            Passkey[]
  mobileAuthCodes     MobileAuthCode[]
  usageCounters       UsageCounter[]
}

/// UNUSED, and empty. Left declared for the same reason as User.plusUntil: the
/// table exists in both databases, and a schema that omits it would be a lie
/// about what is there. Delete both together if the paywall is ruled out for
/// good; keep them if it is only deferred.
model UsageCounter {
  id     String @id @default(uuid())
  userId String
  /// YYYY-MM
  month  String
  /// 'import' | 'ask'
  kind   String
  used   Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, kind])
  @@index([userId])
}

/// Short-lived one-time code handed to the app after a browser sign-in.
///
/// The bearer token is never put in the redirect URL: deep-link URLs end up in
/// system logs and can be surfaced by the OS, so the app receives a code it
/// immediately trades for the real token over HTTPS. Single use, two minutes.
model MobileAuthCode {
  code      String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Server-issued nonce for a Sign in with Apple attempt.
///
/// Apple echoes the nonce back verbatim on the native flow rather than hashing
/// it, so a client-chosen value proves nothing — the client could replay its
/// own token along with its own nonce. Only a value this server issued and
/// remembers rules that out. Separate from MobileAuthCode because a nonce is
/// issued before anyone is identified, so it has no user to belong to.
model AppleNonce {
  nonce     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// A WebAuthn passkey (biometric / device credential) bound to a user. The
/// private key never leaves the user's device; we store only the public key,
/// the credential id, and a signature counter for replay detection.
model Passkey {
  id           String   @id @default(uuid())
  userId       String
  credentialId String   @unique // base64url credential id
  publicKey    Bytes // COSE public key
  counter      Int      @default(0)
  transports   String? // comma-joined transport hints (e.g. "internal,hybrid")
  deviceName   String? // optional user-facing label
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Server-side login session. The cookie holds only the random `token`; all
/// other state lives here so sessions are revocable (delete the row → logged
/// out everywhere). Distinct from EmailAccount, which holds Gmail-ingestion
/// OAuth tokens, not login identity.
model Session {
  id        String   @id @default(uuid())
  token     String   @unique // random opaque value stored in the cookie
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Monthly spending cap per category. One row per user/category — when set,
/// the home page shows a progress bar and a soft warning at 80%/100%.
model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  amountInr  Decimal
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

/// User-defined payment methods (Card, Cash, UPI, etc., plus anything the
/// user adds — Wallet, Gift Card, BNPL, etc.). Transaction.paymentMode is a
/// string referencing PaymentMode.value within the user's set.
model PaymentMode {
  id        String   @id @default(uuid())
  userId    String
  value     String // canonical lowercase key (e.g. "wallet")
  label     String // display name (e.g. "Wallet")
  builtin   Boolean  @default(false) // built-in modes can't be deleted by the user
  archived  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, value])
}

/// Tokens are AES-256-GCM encrypted at rest; ciphertext stored base64.
/// A connected mailbox. One user may connect several — bank alerts are often
/// split across a personal Gmail and a work or Outlook address, and forcing a
/// choice between them silently loses half someone's spending.
model EmailAccount {
  id              String    @id @default(uuid())
  userId          String
  provider        String    @default("gmail")
  accountEmail    String // the connected Gmail address, for display
  refreshTokenEnc String // ciphertext of OAuth refresh token
  accessTokenEnc  String? // optional cache of last access token
  expiresAt       DateTime? // access token expiry (informational)
  scope           String // granted scopes, space-separated
  lastSyncedAt    DateTime?
  lastHistoryId   String? // Gmail history ID for incremental sync (later)
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The same address cannot be connected twice by one person, but different
  // addresses — and different providers — can.
  @@unique([userId, accountEmail])
  @@index([userId])
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String
  occurredAt    DateTime
  merchantRaw   String?
  merchant      String
  amount        Decimal
  paymentMode   String
  source        String
  type          String   @default("debit") // 'debit' (spending) | 'credit' (income / refund)
  externalId    String?
  note          String?
  importBatchId String?
  emailId       String?
  createdAt     DateTime @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch ImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  email       ReceivedEmail? @relation(fields: [emailId], references: [id], onDelete: SetNull)
  lines       ExpenseLine[]

  @@unique([userId, externalId])
  @@index([userId, occurredAt])
}

model ExpenseLine {
  id            String  @id @default(uuid())
  transactionId String
  categoryId    String
  amount        Decimal
  note          String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  parentId  String?
  icon      String?
  color     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]           @relation("CategoryHierarchy")
  lines    ExpenseLine[]
  rules    CategorizationRule[]
  budgets  Budget[]

  @@unique([userId, parentId, name])
}

/// A friendlier name for a merchant string the bank gave us.
///
/// UPI narrations arrive as things like "DEVMAN VENTURES PRIVAT" or a stranger's
/// legal name, which nobody can match to a purchase they actually remember. When
/// someone corrects one, that correction is kept and reused: the same raw string
/// is renamed on sight from then on, and past transactions are brought along.
///
/// Keyed on the *original* text, not the display name, so a second rename simply
/// updates where the same key points.
model MerchantAlias {
  id          String   @id @default(uuid())
  userId      String
  /// Normalized (trimmed, lowercased) original merchant text.
  matchValue  String
  /// What to show instead.
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchValue])
  @@index([userId])
}

/// User-supplied corrections that compound into accuracy.
/// When the user changes a wrong AI category, we ask "always do this?" and save a rule.
/// Rules apply during email ingestion BEFORE the LLM is called.
model CategorizationRule {
  id           String   @id @default(uuid())
  userId       String
  matcherType  String // 'merchant' | 'email_from'
  matcherValue String // case-insensitive contains for merchant; case-insensitive exact for email_from
  categoryId   String
  priority     Int      @default(0) // higher wins on conflict
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, matcherType, matcherValue])
  @@index([userId, matcherType])
}

model ImportBatch {
  id         String   @id @default(uuid())
  userId     String
  filename   String
  bank       String
  rowCount   Int
  importedAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model ReceivedEmail {
  id          String   @id @default(uuid())
  userId      String
  messageId   String? // Gmail message id (used for dedup with Gmail API)
  uid         Int? // legacy IMAP UID — unused after the OAuth switch
  fromAddress String
  subject     String
  rawHtml     String // HTML body, or '' if text-only
  bodyText    String? // plain-text body when present
  receivedAt  DateTime
  parseStatus String   @default("pending") // 'pending' | 'parsed' | 'failed' | 'ignored'
  parseError  String?
  createdAt   DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, messageId])
  @@unique([userId, uid])
  @@index([userId, receivedAt])
}
